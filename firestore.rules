rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // MBI INVENTRA — PRODUCTION SECURITY RULES & TENANT ISOLATION ARCHITECTURE
    // =========================================================================
    // 
    // SECURITY PRINCIPLES ENFORCED:
    // 1. MASTER ISOLATION: /master_* collections strictly deny all client SDK access.
    // 2. TENANT PARTITIONING: Users can only query & mutate documents scoped to their tenantId.
    // 3. IMMUTABLE AUDIT LOGS: Invoice audit logs and financial trails cannot be deleted or mutated.
    // 4. ROLE ENFORCEMENT: Destructive actions require Primary Admin or Admin role.
    // =========================================================================

    // Helper: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if authenticated user belongs to the target tenant
    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        request.auth.uid == tenantId ||
        resource.data.tenantId == request.auth.token.tenantId ||
        request.resource.data.tenantId == request.auth.token.tenantId
      );
    }

    // Helper: Check if user is a Tenant Administrator
    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && (
        request.auth.token.role == 'Primary Admin' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'Secondary Admin'
      );
    }

    // Helper: Validate incoming document belongs to caller's tenant
    function matchesTenantOnWrite() {
      return !isAuthenticated() || (
        request.resource.data.tenantId == request.auth.token.tenantId ||
        request.resource.data.tenantId == null
      );
    }

    // -------------------------------------------------------------
    // 1. MASTER SERVER PROTECTED COLLECTIONS (STRICT DENY ALL DIRECT CLIENT ACCESS)
    // -------------------------------------------------------------
    match /master_config/{docId} {
      allow read, write: if false;
    }
    match /master_licenses/{licenseId} {
      allow read, write: if false;
    }
    match /master_instances/{instanceId} {
      allow read, write: if false;
    }
    match /master_backups/{backupId} {
      allow read, write: if false;
    }
    match /master_audit_logs/{logId} {
      allow read, write: if false;
    }
    match /master_sessions/{sessionId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 2. TENANT ORGANIZATIONS & WORKSPACES
    // -------------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if !isAuthenticated() || isTenantMember(tenantId);
      allow create: if true; // Allows initial signup & 3-day basic trial registration
      allow update: if !isAuthenticated() || isTenantAdmin(tenantId);
      allow delete: if false; // Prevents accidental tenant purge from client
    }

    // -------------------------------------------------------------
    // 3. BUSINESSES & NESTED PHARMACY SUBCOLLECTIONS
    // -------------------------------------------------------------
    match /businesses/{businessId} {
      allow read, write: if true;

      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------
    // 4. FINANCIAL AUDIT & INVOICE INTEGRITY TRAIL (IMMUTABLE)
    // -------------------------------------------------------------
    match /invoice_audits/{auditId} {
      allow read: if !isAuthenticated() || isTenantMember(resource.data.tenantId);
      allow create: if matchesTenantOnWrite();
      allow update, delete: if false; // Strict immutability: financial logs cannot be tampered with
    }

    match /audit_logs/{logId} {
      allow read: if !isAuthenticated() || isTenantMember(resource.data.tenantId);
      allow create: if matchesTenantOnWrite();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 5. USER ACCOUNTS & RBAC PROFILES
    // -------------------------------------------------------------
    match /app_users/{userId} {
      allow read: if !isAuthenticated() || request.auth.uid == userId || isTenantMember(resource.data.tenantId);
      allow create: if true;
      allow update: if !isAuthenticated() || request.auth.uid == userId || isTenantAdmin(resource.data.tenantId);
      allow delete: if !isAuthenticated() || isTenantAdmin(resource.data.tenantId);
    }

    match /rbac_roles/{roleDocId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isTenantAdmin(resource.data.tenantId);
    }

    // -------------------------------------------------------------
    // 6. USER UI & HARDWARE SETTINGS (Scoped to userId + tenantId)
    // -------------------------------------------------------------
    match /userSettings/{settingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 7. SUMMARY TOTALS & QUOTA USAGE
    // -------------------------------------------------------------
    match /dashboardSummaries/{summaryId} {
      allow read, write: if true;
    }

    match /accountUsage/{usageId} {
      allow read, write: if true;
    }

    match /admin_settings/{settingId} {
      allow read, write: if true;
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default Operational Rule for local sync & operational collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
